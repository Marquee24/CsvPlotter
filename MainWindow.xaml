<Window x:Class="CsvPlotter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="CSV Parameter Plotter"
        Width="1400"
        Height="800"
        MinWidth="900"
        MinHeight="500">

    <Grid Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0"
                Padding="8"
                Margin="0,0,0,8"
                BorderBrush="LightGray"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto" MinWidth="89"/>
                    <ColumnDefinition Width="114.497"/>
                    <ColumnDefinition Width="Auto" MinWidth="442.88"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BrowseButton"
            Grid.Column="0"
            Margin="0,0,8,0"
            Content="Browse CSV"
            Click="BrowseButton_Click" Height="30" VerticalAlignment="Center"/>

                <TextBox x:Name="FilePathTextBox"
             Grid.Column="1"
             VerticalContentAlignment="Center"
             IsReadOnly="True" Margin="0,0,10,0" Grid.ColumnSpan="3"/>
                <TextBlock Grid.Column="4"
               Margin="142,0,234,0"
               VerticalAlignment="Center"
               Text="Min Rows:" Height="16"/>

                <TextBox x:Name="MinRowsTextBox"
             Grid.Column="4"
             VerticalContentAlignment="Center"
             Text="0" Margin="214,0,185,0"/>

                <TextBlock Grid.Column="4"
               Margin="273,0,100,0"
               VerticalAlignment="Center"
               Text="Max Rows:" Height="16"/>

                <TextBox x:Name="MaxRowsTextBox"
             Grid.Column="4"
             VerticalContentAlignment="Center"
             Text="2000" Margin="338,0,56,0"/>

                <Button x:Name="LoadButton"
            Grid.Column="4"
            Margin="392,0,0,0"
            Content="Load"
            Click="LoadButton_Click"/>
                <TextBlock Grid.Column="4"
                    Margin="10,0,369,0"
                    VerticalAlignment="Center"
                    Text="Resolution:" Height="16"/>
                <TextBox x:Name="ResolutionTextBox"
                    Grid.Column="4"
                    VerticalContentAlignment="Center"
                    Text="10000" Margin="79,0,306,0"/>

            </Grid>
        </Border>


        <!-- MAIN AREA -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- Plot -->
                <ColumnDefinition Width="*"/>

                <!-- Splitter -->
                <ColumnDefinition Width="5"/>

                <!-- Parameters -->
                <ColumnDefinition Width="340"/>

            </Grid.ColumnDefinitions>


            <!-- PLOT -->
            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1">

                <scottPlot:WpfPlot x:Name="PlotControl"/>

            </Border>


            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>


            <!-- RIGHT PANEL -->
            <Border Grid.Column="2"
                    Margin="5,0,0,0"
                    BorderBrush="Gray"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="111"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>


                    <!-- TIME -->
                    <Border Grid.Row="0"
                            Padding="8"
                            BorderBrush="LightGray"
                            BorderThickness="0,0,0,1">

                        <Grid Margin="0,0,0,1">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Margin="0,16,8,0"
                                       VerticalAlignment="Top"
                                       FontWeight="Bold"
                                       Text="Time:"/>

                            <TextBox x:Name="CursorTimeTextBox"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Text="--" Margin="0,10,0,55" Grid.Column="1"/>
                            <TextBlock Grid.Column="0"
                                Margin="0,61,8,0"
                                VerticalAlignment="Top"
                                FontWeight="Bold"
                                Text="Record :"/>
                            <TextBox x:Name="CursorRecordTextBox"
                                Height="28"
                                VerticalContentAlignment="Center"
                                IsReadOnly="True"
                                Text="--" Margin="0,55,0,10" Grid.Column="1"/>

                        </Grid>

                    </Border>


                    <!-- PARAMETER LIST -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="-3,0,0,0">

                        <StackPanel x:Name="ParameterPanel"
                                    Margin="8"/>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>


        <!-- STATUS -->
        <Border Grid.Row="2"
                Margin="0,8,0,0"
                Padding="5"
                BorderBrush="LightGray"
                BorderThickness="1">

            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       VerticalAlignment="Center"/>

        </Border>

    </Grid>

</Window>