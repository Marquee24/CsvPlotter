<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/10/nuspec.xsd">
  <metadata>
    <id>OpenTK.GLWpfControl</id>
    <version>4.3.3</version>
    <title>OpenTK.GLWpfControl</title>
    <authors>varon NogginBops</authors>
    <owners>varon NogginBops</owners>
    <licenseUrl>https://github.com/varon/GLWpfControl/blob/master/LICENSE.md</licenseUrl>
    <projectUrl>https://www.opentk.net</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/opentk/opentk.net/docfx/assets/opentk.png</iconUrl>
    <description>A native WPF control for OpenTK 4.X.</description>
    <summary>A native WPF control for OpenTK 4.8.0+</summary>
    <releaseNotes>Fix crashes related to `Dispose` and unloading of the control in general. (@Krugpelke, @NogginBops, @timsol, @4nonym0us)
Fixed issue where `GLWpfControl.Framebuffer` property stopped working. (@insel-maz, @NogginBops)
Hopefully fixed a few crashes related to MSAA not being supported. (@NogginBops)
Added `GLWpfControl.SupportsMSAA` property to check if MSAA will be supported. (@NogginBops)</releaseNotes>
    <copyright>Copyright (c) 2022 Team OpenTK.</copyright>
    <dependencies>
      <dependency id="OpenTK" version="[4.8.2,5.0.0)" />
    </dependencies>
  </metadata>
</package>