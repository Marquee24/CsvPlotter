<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ScottPlot</id>
    <version>5.1.59</version>
    <authors>Scott Harden</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>readme.md</readme>
    <projectUrl>https://scottplot.net/</projectUrl>
    <description>ScottPlot is a free and open-source plotting library for .NET. This package can be used to create static plots, and user controls for displaying plots interactively are available as separate NuGet packages.</description>
    <copyright>Copyright (c) Scott Harden / Harden Technologies, LLC</copyright>
    <tags>plot graph data chart signal line bar heatmap scatter</tags>
    <repository type="git" url="https://github.com/ScottPlot/ScottPlot.git" branch="refs/heads/main" commit="fc81e78241e532daa97b47049b399dff81e80054" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="HarfBuzzSharp.NativeAssets.Linux" version="8.3.1.1" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp" version="3.119.0" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.HarfBuzz" version="3.119.0" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.NativeAssets.Linux.NoDependencies" version="3.119.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="HarfBuzzSharp.NativeAssets.Linux" version="8.3.1.1" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp" version="3.119.0" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.HarfBuzz" version="3.119.0" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.NativeAssets.Linux.NoDependencies" version="3.119.0" exclude="Build,Analyzers" />
        <dependency id="System.ValueTuple" version="4.6.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="HarfBuzzSharp.NativeAssets.Linux" version="8.3.1.1" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp" version="3.119.0" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.HarfBuzz" version="3.119.0" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.NativeAssets.Linux.NoDependencies" version="3.119.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="HarfBuzzSharp.NativeAssets.Linux" version="8.3.1.1" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp" version="3.119.0" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.HarfBuzz" version="3.119.0" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.NativeAssets.Linux.NoDependencies" version="3.119.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="HarfBuzzSharp.NativeAssets.Linux" version="8.3.1.1" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp" version="3.119.0" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.HarfBuzz" version="3.119.0" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.NativeAssets.Linux.NoDependencies" version="3.119.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>