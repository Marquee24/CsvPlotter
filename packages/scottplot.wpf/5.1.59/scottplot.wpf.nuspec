<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ScottPlot.WPF</id>
    <version>5.1.59</version>
    <authors>Scott Harden</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>readme.md</readme>
    <projectUrl>https://scottplot.net/</projectUrl>
    <description>User controls for displaying interactive plots in WPF applications</description>
    <copyright>Copyright (c) Scott Harden / Harden Technologies, LLC</copyright>
    <tags>plot graph data chart signal line bar heatmap scatter</tags>
    <repository type="git" url="https://github.com/ScottPlot/ScottPlot.git" branch="refs/heads/main" commit="fc81e78241e532daa97b47049b399dff81e80054" />
    <dependencies>
      <group targetFramework="net10.0-windows7.0">
        <dependency id="ScottPlot" version="5.1.59" exclude="Build,Analyzers" />
        <dependency id="OpenTK" version="4.9.4" exclude="Build,Analyzers" />
        <dependency id="OpenTK.GLWpfControl" version="4.3.3" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.Views.WPF" version="3.119.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="ScottPlot" version="5.1.59" exclude="Build,Analyzers" />
        <dependency id="OpenTK" version="3.3.1" exclude="Build,Analyzers" />
        <dependency id="OpenTK.GLWpfControl" version="3.3.0" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.Views.WPF" version="3.119.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0-windows7.0">
        <dependency id="ScottPlot" version="5.1.59" exclude="Build,Analyzers" />
        <dependency id="OpenTK" version="4.9.4" exclude="Build,Analyzers" />
        <dependency id="OpenTK.GLWpfControl" version="4.3.3" exclude="Build,Analyzers" />
        <dependency id="SkiaSharp.Views.WPF" version="3.119.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net10.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
      <group targetFramework=".NETFramework4.6.2" />
      <group targetFramework="net8.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
    </frameworkReferences>
  </metadata>
</package>